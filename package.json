{
  "name": "livepoll",
  "version": "1.0.0",
  "description": "LivePoll - Kahoot-style live polling tool on Cloudflare Workers + D1 (100% local)",
  "main": "src/worker/index.js",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state --port 8787",
    "db:migrate": "wrangler d1 migrations apply livepoll_db --local --persist-to .wrangler/state",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bixtecnologia/aulao_agentes.git"
  },
  "keywords": [],
  "author": "",
