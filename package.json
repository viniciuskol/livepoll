  "bugs": {
    "url": "https://github.com/bixtecnologia/aulao_agentes/issues"
  },
  "homepage": "https://github.com/bixtecnologia/aulao_agentes#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.124.0"
  },
  "type": "module"
}
